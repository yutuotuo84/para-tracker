# TickTick OAuth 配置
# TICKTICK_CLIENT_ID=your_client_id
# TICKTICK_CLIENT_SECRET=your_client_secret
TICKTICK_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
TICKTICK_USERNAME=your_email@example.com
TICKTICK_PASSWORD=your_password

# Flomo 专属记录 API
FLOMO_API_URL=https://flomoapp.com/iwh/your_id/your_token/

# AI 摘要 (可选)
# OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# SUMMARY_MODEL=gpt-4o-mini

# 应用配置
APP_PORT=8000
SYNC_INTERVAL_SECONDS=60

# 数据库（可选，默认使用 SQLite）
# 使用 PostgreSQL 时取消注释并填写：
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/para_tracker

# ─── 多用户系统 ───
# 启动后访问 /login 注册账号即可使用
# 无需额外配置
